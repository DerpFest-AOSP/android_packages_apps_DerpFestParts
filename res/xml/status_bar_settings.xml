<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    android:key="status_bar_settings"
    android:title="@string/status_bar_title">

    <lineageos.preference.LineageSystemSettingListPreference
        android:key="qs_quick_pulldown"
        android:title="@string/status_bar_quick_qs_pulldown_title"
        android:entries="@array/status_bar_quick_qs_pulldown_entries"
        android:entryValues="@array/status_bar_quick_qs_pulldown_values"
        android:defaultValue="0" />

    <org.derpfest.support.preferences.SystemSettingSwitchPreference
        android:key="status_bar_brightness_control"
        android:title="@string/status_bar_brightness_control_title"
        android:summary="@string/status_bar_brightness_control_summary"
        android:defaultValue="false" />

    <org.derpfest.support.preferences.SystemSettingSwitchPreference
        android:key="status_bar_brightness_control_lockscreen"
        android:title="@string/status_bar_brightness_control_lockscreen_title"
        android:summary="@string/status_bar_brightness_control_lockscreen_summary"
        android:dependency="status_bar_brightness_control"
        android:defaultValue="false" />

    <Preference
        android:key="status_bar_lyric_settings"
        android:title="@string/status_bar_lyric_title"
        android:summary="@string/status_bar_lyric_summary"
        android:fragment="org.lineageos.lineageparts.statusbar.StatusbarLyricSettings"/>

    <!-- Carrier label -->
    <PreferenceCategory
        android:key="status_bar_carrier_key"
        android:title="@string/status_bar_carrier_category_title">

        <org.derpfest.support.preferences.SystemSettingListPreference
            android:key="lockscreen_show_carrier"
            android:title="@string/lockscreen_show_carrier_title"
            android:dialogTitle="@string/lockscreen_show_carrier_title"
            android:summary="%s"
            android:entries="@array/status_bar_carrier_display_entries"
            android:entryValues="@array/status_bar_carrier_display_values"
            android:defaultValue="1" />

        <Preference
            android:key="lockscreen_show_custom_carrier_text"
            android:title="@string/custom_carrier_label_title"
            android:summary="@string/custom_carrier_label_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/status_bar_icons_title">

        <Preference
            android:key="status_bar_icons"
            android:title="@string/status_bar_system_icons_title"
            android:summary="@string/status_bar_system_icons_summary">
            <intent android:action="com.android.settings.action.STATUS_BAR_TUNER" />
        </Preference>

        <Preference
            android:key="status_bar_logo"
            android:title="@string/status_bar_logo_title"
            android:summary="@string/status_bar_logo_summary"
            android:fragment="org.lineageos.lineageparts.statusbar.StatusBarLogo" />

        <org.derpfest.support.preferences.SystemSettingIntListPreference
            android:key="statusbar_icon_tint_mode"
            android:title="@string/status_bar_icon_tint_mode_title"
            android:summary="@string/status_bar_icon_tint_mode_summary"
            android:entries="@array/status_bar_icon_tint_entries"
            android:entryValues="@array/status_bar_icon_tint_values"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true" />

        <org.derpfest.support.colorpicker.ColorPickerSystemPreference
            android:key="statusbar_icon_tint_custom_color"
            android:title="@string/status_bar_icon_tint_custom_title"
            android:summary="@string/status_bar_icon_tint_custom_summary"
            android:defaultValue="-1"
            app:defaultDisplayColorRes="@android:color/white" />

        <org.derpfest.support.preferences.SystemSettingSwitchPreference
            android:key="statusbar_combined_notif_count"
            android:title="@string/status_bar_combined_notification_count"
            android:summary="@string/status_bar_combined_notification_count_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="status_bar_clock_key"
        android:title="@string/status_bar_clock_title">

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_clock"
            android:title="@string/status_bar_clock_position_title"
            android:dialogTitle="@string/status_bar_clock_position_title"
            android:entries="@array/status_bar_clock_position_entries"
            android:entryValues="@array/status_bar_clock_position_values"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true" />

        <lineageos.preference.SecureSettingSwitchPreference
            android:key="clock_seconds"
            android:title="@string/status_bar_clock_show_seconds_title"
            android:summary="@string/status_bar_clock_show_seconds_summary"
            android:defaultValue="false" />

        <lineageos.preference.LineageSystemSettingSwitchPreference
            android:key="status_bar_clock_auto_hide"
            android:title="@string/status_bar_clock_auto_hide_title"
            android:summary="@string/status_bar_clock_auto_hide_summary"
            android:defaultValue="false" />

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_am_pm"
            android:title="@string/status_bar_am_pm_title"
            android:dialogTitle="@string/status_bar_am_pm_title"
            android:entries="@array/status_bar_am_pm_entries"
            android:entryValues="@array/status_bar_am_pm_values"
            android:defaultValue="2"
            app:useSimpleSummaryProvider="true" />

        <org.lineageos.lineageparts.statusbar.StatusBarClockChipStylePreference
            android:key="statusbar_clock_chip"
            android:title="@string/statusbar_clock_chip_title"
            android:summary="%s"
            android:defaultValue="0" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="status_bar_battery_key"
        android:title="@string/status_bar_battery_title">

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_battery_style"
            android:title="@string/status_bar_battery_style_title"
            android:dialogTitle="@string/status_bar_battery_style_title"
            android:entries="@array/status_bar_battery_style_entries"
            android:entryValues="@array/status_bar_battery_style_values"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true" />

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="status_bar_show_battery_percent"
            android:title="@string/status_bar_battery_percentage_title"
            android:dialogTitle="@string/status_bar_battery_percentage_title"
            android:entries="@array/status_bar_battery_percentage_entries"
            android:entryValues="@array/status_bar_battery_percentage_values"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/status_bar_brightness_category">

        <lineageos.preference.LineageSecureSettingListPreference
            android:key="qs_show_brightness_slider"
            android:title="@string/status_bar_brightness_slider_title"
            android:dialogTitle="@string/status_bar_brightness_slider_title"
            android:entries="@array/status_bar_brightness_slider_entries"
            android:entryValues="@array/status_bar_brightness_slider_values"
            android:defaultValue="1"
            app:useSimpleSummaryProvider="true" />

        <lineageos.preference.LineageSecureSettingListPreference
            android:key="qs_brightness_slider_position"
            android:title="@string/status_bar_brightness_slider_position_title"
            android:dependency="qs_show_brightness_slider"
            android:entries="@array/status_bar_brightness_slider_position_entries"
            android:entryValues="@array/status_bar_brightness_slider_position_values"
            android:defaultValue="0"
            app:useSimpleSummaryProvider="true" />

        <lineageos.preference.LineageSecureSettingSwitchPreference
            android:key="qs_show_auto_brightness"
            android:title="@string/status_bar_brightness_slider_auto_title"
            android:summary="@string/status_bar_brightness_slider_auto_summary"
            android:dependency="qs_show_brightness_slider"
            lineage:requiresConfig="@*android:bool/config_automatic_brightness_available"
            android:defaultValue="true" />
    </PreferenceCategory>

</PreferenceScreen>
