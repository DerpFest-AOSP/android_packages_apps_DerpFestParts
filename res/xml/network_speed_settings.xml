<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/network_speed_settings_title">

    <org.derpfest.support.preferences.SecureSettingMainSwitchPreference
        android:key="status_bar_show_network_speed"
        android:title="@string/network_speed_switch_title"
        android:summary="@string/network_speed_switch_summary"
        android:defaultValue="true" />

    <org.derpfest.support.preferences.SecureSettingSeekBarPreference
        android:key="status_bar_network_speed_threshold"
        android:title="@string/network_speed_threshold_title"
        android:summary="@string/network_speed_threshold_summary"
        android:defaultValue="1"
        android:max="100"
        android:dependency="status_bar_show_network_speed"
        settings:min="0"
        settings:interval="1"
        settings:units="@string/network_speed_threshold_units" />

</PreferenceScreen>
