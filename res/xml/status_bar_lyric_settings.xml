<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/status_bar_lyric_title">

    <PreferenceCategory
        android:key="lyric_translation"
        android:title="@string/status_bar_lyric_section_translation">

        <org.derpfest.support.preferences.SecureSettingSwitchPreference
            android:key="status_bar_lyric_show_translation"
            android:title="@string/status_bar_lyric_show_translation_title"
            android:summary="@string/status_bar_lyric_show_translation_summary"
            android:defaultValue="false" />

        <org.derpfest.support.preferences.SecureSettingListPreference
            android:key="status_bar_lyric_translation_target"
            android:title="@string/status_bar_lyric_translation_target_title"
            android:entries="@array/status_bar_lyric_translation_target_entries"
            android:entryValues="@array/status_bar_lyric_translation_target_values"
            android:defaultValue="system"
            android:dependency="status_bar_lyric_show_translation" />

        <org.derpfest.support.preferences.SecureSettingSwitchPreference
            android:key="status_bar_lyric_translation_wifi_only"
            android:title="@string/status_bar_lyric_translation_wifi_only_title"
            android:summary="@string/status_bar_lyric_translation_wifi_only_summary"
            android:defaultValue="true"
            android:dependency="status_bar_lyric_show_translation" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="lyric_sources"
        android:title="@string/status_bar_lyric_section_sources">

        <org.derpfest.support.preferences.SecureSettingSwitchPreference
            android:key="status_bar_lyric_word_timing"
            android:title="@string/status_bar_lyric_word_timing_title"
            android:summary="@string/status_bar_lyric_word_timing_summary"
            android:defaultValue="true" />

        <Preference
            android:key="status_bar_lyric_sources"
            android:title="@string/status_bar_lyric_sources_title" />
    </PreferenceCategory>
</PreferenceScreen>
