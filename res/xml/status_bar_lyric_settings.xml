<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/status_bar_lyric_title">

    <org.derpfest.support.preferences.SecureSettingMainSwitchPreference
        android:key="status_bar_show_lyric"
        android:title="@string/status_bar_show_lyric_title"
        android:defaultValue="false" />

    <PreferenceCategory
        android:key="lyric_details"
        android:title="@string/status_bar_lyric_section_behavior"
        android:dependency="status_bar_show_lyric">

        <org.derpfest.support.preferences.SecureSettingListPreference
            android:key="status_bar_lyric_position"
            android:title="@string/status_bar_lyric_position_title"
            android:entries="@array/status_bar_lyric_position_entries"
            android:entryValues="@array/status_bar_lyric_position_values"
            android:defaultValue="0" />

        <org.derpfest.support.preferences.SecureSettingSwitchPreference
            android:key="status_bar_lyric_show_translation"
            android:title="@string/status_bar_lyric_show_translation_title"
            android:summary="@string/status_bar_lyric_show_translation_summary"
            android:defaultValue="false" />

        <org.derpfest.support.preferences.SecureSettingSwitchPreference
            android:key="status_bar_lyric_word_timing"
            android:title="@string/status_bar_lyric_word_timing_title"
            android:summary="@string/status_bar_lyric_word_timing_summary"
            android:defaultValue="true" />

        <org.derpfest.support.preferences.SecureSettingSwitchPreference
            android:key="status_bar_lyric_hide_icon_clock_right"
            android:title="@string/status_bar_lyric_hide_icon_clock_right_title"
            android:summary="@string/status_bar_lyric_hide_icon_clock_right_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="lyric_sources"
        android:title="@string/status_bar_lyric_section_sources"
        android:dependency="status_bar_show_lyric">

        <Preference
            android:key="status_bar_lyric_sources"
            android:title="@string/status_bar_lyric_sources_title" />
    </PreferenceCategory>
</PreferenceScreen>
