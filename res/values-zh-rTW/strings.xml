    <!-- Trust interface -->
    <string name="trust_title" translatable="false">@*lineageos.platform:string/trust_feature_name</string>
    <string name="trust_category_features">狀態</string>
    <string name="trust_feature_selinux">SELinux</string>
    <string name="trust_feature_selinux_value_enforcing">強制模式</string>
    <string name="trust_feature_selinux_value_disabled">已停用</string>
    <string name="trust_feature_selinux_explain">SELinux 決定了哪些程式對裝置上的哪些檔案/路徑擁有存取權限。\n這能防止應用程式與服務存取它們不該存取的檔案：如此一來，潛在的惡意程式將受到限制，您的安全性也得以儲存。</string>
    <string name="trust_feature_security_patches">Android 安全性修補程式</string>
    <string name="trust_feature_security_patches_value_base">平台：%1$s\n廠商：%2$s</string>
    <string name="trust_feature_security_patches_value_new">最新狀態</string>
    <string name="trust_feature_security_patches_value_medium">過期幾個月</string>
    <string name="trust_feature_security_patches_value_old">已過期</string>
    <string name="trust_feature_security_patches_explain">安全性修補程式由 Google 與 SoC 廠商每月定期釋出，以解決惡意應用程式可能利用的漏洞，避免其繞過安全限制並對您的裝置造成永久性損壞。Google 提供的修補程式會套用於所有受支援的裝置，但專有程式碼的修補程式僅能由您的裝置製造商套用。為了確保您的裝置安全，請確保您的 DerpFest 版本始終為最新，並（若適用）確保您的廠商映像檔已更新為 DerpFest 建議的最新版本。</string>
    <string name="trust_feature_encryption">加密</string>
    <string name="trust_feature_encryption_value_enabled">已啟用</string>
    <string name="trust_feature_encryption_value_nolock">需要安全鎖定畫面</string>
    <string name="trust_feature_encryption_value_disabled">已停用</string>
    <string name="trust_feature_encryption_explain">加密您的裝置可防止在手機未開機進入 Android 時存取您的資料。如果您的手機被竊，這點特別重要，因為它可以防止他人在沒有密碼的情況下讀取您的訊息、聯絡人與其他私密資訊。\n若要使加密更有效，您需要設定安全鎖定畫面密碼。</string>
