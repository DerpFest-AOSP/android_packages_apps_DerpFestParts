    <string name="trust_warnings_keys">建構簽章</string>
    <string name="trust_onboarding_title">認識 Trust</string>
    <string name="trust_onboarding_description">Trust 協助您保持裝置安全並保護您的隱私。\nTrust 圖示僅會在頁面內容經過驗證時顯示。</string>
